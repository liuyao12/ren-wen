168\u4e16\u754c\u90fd\u5c5e\u4e8e<b><a href=\"https://zh.wikipedia.org/wiki/%E5%85%AC%E6%9C%89%E9%A2%86%E5%9F%9F\" class=\"extiw\" title=\"w:\u516c\u6709\u9886\u57df\">\u516c\u6709\u9886\u57df</a></b>\uff0c\u56e0\u4e3a\u4f5c\u8005\u901d\u4e16\u5df2\u7ecf\u8d85\u8fc7100\u5e74\uff0c\u4e14\u4f5c\u54c1\u4e8e1931\u5e741\u67081\u65e5\u4e4b\u524d\u51fa\u7248\u3002\n</p>\n</div>\n</div><div>\n<p><span class=\"noimageRight\"></span>\n</p>\n</div></div></div></div>\n<div class=\"licensetpl\">\n<p><span class=\"licensetpl&#95;short\">Public domain</span><span class=\"licensetpl&#95;long\">Public domain</span><span class=\"licensetpl&#95;link&#95;req\">false</span><span class=\"licensetpl&#95;attr&#95;req\">false</span>\n</p>\n</div>\n</div></div>"},"sections":[{"toclevel":1,"level":"2","line":"\u6c88\u6842\u82ac","number":"1","index":"1","fromtitle":"\u6e05\u53f2\u7a3f/\u5377436","byteoffset":192,"anchor":"\u6c88\u6842\u82ac","linkAnchor":"\u6c88\u6842\u82ac"},{"toclevel":1,"level":"2","line":"\u674e\u9d3b\u85fb","number":"2","index":"2","fromtitle":"\u6e05\u53f2\u7a3f/\u5377436","byteoffset":720,"anchor":"\u674e\u9d3b\u85fb","linkAnchor":"\u674e\u9d3b\u85fb"},{"toclevel":1,"level":"2","line":"\u7fc1\u540c\u9fa2","number":"3","index":"3","fromtitle":"\u6e05\u53f2\u7a3f/\u5377436","byteoffset":1951,"anchor":"\u7fc1\u540c\u9fa2","linkAnchor":"\u7fc1\u540c\u9fa2"},{"toclevel":1,"level":"2","line":"\u5b6b\u6bd3\u6c76","number":"4","index":"4","fromtitle":"\u6e05\u53f2\u7a3f/\u5377436","byteoffset":3310,"anchor":"\u5b6b\u6bd3\u6c76","linkAnchor":"\u5b6b\u6bd3\u6c76"},{"toclevel":1,"level":"2","line":"\u8ad6\u66f0","number":"5","index":"5","fromtitle":"\u6e05\u53f2\u7a3f/\u5377436","byteoffset":3821,"anchor":"\u8ad6\u66f0","linkAnchor":"\u8ad6\u66f0"}],"showtoc":""}}