\u516c\u6709\u9886\u57df</a></b>\uff0c\u56e0\u4e3a\u4f5c\u8005\u901d\u4e16\u5df2\u7ecf\u8d85\u8fc7100\u5e74\uff0c\u4e14\u4f5c\u54c1\u4e8e1931\u5e741\u67081\u65e5\u4e4b\u524d\u51fa\u7248\u3002\n</p>\n</div>\n</div><div>\n<p><span class=\"noimageRight\"></span>\n</p>\n</div></div></div></div>\n<div class=\"licensetpl\">\n<p><span class=\"licensetpl&#95;short\">Public domain</span><span class=\"licensetpl&#95;long\">Public domain</span><span class=\"licensetpl&#95;link&#95;req\">false</span><span class=\"licensetpl&#95;attr&#95;req\">false</span>\n</p>\n</div>\n</div></div>"},"sections":[{"toclevel":1,"level":"1","line":"\u9678\u5efa\u701b","number":"1","index":"1","fromtitle":"\u6e05\u53f2\u7a3f/\u5377397","byteoffset":168,"anchor":"\u9678\u5efa\u701b","linkAnchor":"\u9678\u5efa\u701b"},{"toclevel":1,"level":"1","line":"\u694a\u6587\u5b9a","number":"2","index":"2","fromtitle":"\u6e05\u53f2\u7a3f/\u5377397","byteoffset":1702,"anchor":"\u694a\u6587\u5b9a","linkAnchor":"\u694a\u6587\u5b9a"},{"toclevel":1,"level":"1","line":"\u9752\u9e9f","number":"3","index":"3","fromtitle":"\u6e05\u53f2\u7a3f/\u5377397","byteoffset":1891,"anchor":"\u9752\u9e9f","linkAnchor":"\u9752\u9e9f"},{"toclevel":1,"level":"1","line":"\u5d07\u7db8","number":"4","index":"4","fromtitle":"\u6e05\u53f2\u7a3f/\u5377397","byteoffset":2713,"anchor":"\u5d07\u7db8","linkAnchor":"\u5d07\u7db8"},{"toclevel":1,"level":"1","line":"\u4f55\u6842\u6e05","number":"5","index":"5","fromtitle":"\u6e05\u53f2\u7a3f/\u5377397","byteoffset":3079,"anchor":"\u4f55\u6842\u6e05","linkAnchor":"\u4f55\u6842\u6e05"},{"toclevel":1,"level":"1","line":"\u3010\u8ad6\u3011","number":"6","index":"6","fromtitle":"\u6e05\u53f2\u7a3f/\u5377397","byteoffset":4759,"anchor":"\u3010\u8ad6\u3011","linkAnchor":"\u3010\u8ad6\u3011"}],"showtoc":""}}