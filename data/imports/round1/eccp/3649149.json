nt:flex-end;text-align:right}@media(max-width:768px){.mw-parser-output .wst-header-mainblock{flex-wrap:wrap}.mw-parser-output .wst-header-central-cell{flex:0 0 100%;order:-2;width:auto}.mw-parser-output .wst-header-back,.mw-parser-output .wst-header-forward{width:auto}}.mw-parser-output .wst-header-notes{display:inline-block;border-collapse:collapse;border-spacing:0;empty-cells:hide;font-size:.9em;line-height:1.4;margin:0 auto 4px auto;width:100%}.mw-parser-output .wst-header-left{float:left}</style><div class=\"ws-header wst-header-structure wst-unknown wst-header ws-header ws-noexport noprint dynlayout-exempt\"><div class=\"wst-header-mainblock wst-unknown-mainblock headertemplate\"><div class=\"wst-header-back searchaux wst-unknown-back\"><div class=\"wst-header-back-arrow\">\u2190</div><div class=\"wst-header-back-link\"><a href=\"/wiki/Eminent_Chinese_of_the_Ch%27ing_Period/Nien_K%C3%AAng-yao\" title=\"Eminent Chinese of the Ch&#39;ing Period/Nien K\u00eang-yao\">Nien K\u00eang-yao</a></div></div><div class=\"wst-header-central-cell wst-unknown-central-cell\"><span class=\"wst-header-title wst-unknown-title\"><span class=\"wst-header-title-text\"><a href=\"/wiki/Eminent_Chinese_of_the_Ch%27ing_Period\" title=\"Eminent Chinese of the Ch&#39;ing Period\">Eminent Chinese of the Ch'ing Period</a>, Volume 1</span><br class=\"wst-header-title-break\" /><span class=\"contributor-text\">edited by&#160;<span class=\"fn\"><a href=\"/wiki/Author:Arthur_W._Hummel\" class=\"mw-redirect\" title=\"Author:Arthur W. Hummel\">Arthur W. Hummel</a></span></span><div class=\"header-section-text\">Nikan (d. 1652) <span class=\"contributor-text\">by&#160;<span class=\"fn\"><a href=\"/wiki/Author:George_A._Kennedy\" class=\"mw-redirect\" title=\"Author:George A. Kennedy\">George A. Kennedy</a></span></span></div></span></div><div class=\"wst-header-forward searchaux wst-unknown-forward\"><div class=\"wst-header-forward-link\"><a href=\"/wiki/Eminent_Chinese_of_the_Ch%27ing_Period/Nikan_(d._1660)\" title=\"Eminent Chinese of the Ch&#39;ing Period/Nikan (d. 1660)\">Nikan (d. 1660)</a></div><div class=\"wst-header-forward-arrow\">\u2192</div></div></div><div class=\"wst-header-notes header&#95;notes searchaux wst-unknown-notes\"><style data-mw-deduplicate=\"TemplateStyles:r14791120\">.mw-parser-output .plainSister{display:block;font-size:93%;line-height:normal;list-style-type:none;list-style-image:none;list-style-position:outside;border:1px solid var(--border-color-interactive--hover,#AAA);float:right;clear:right;margin:0.5ex 0 0.5ex 0.5ex;padding:0;background:var(--background-color-base,#FFFFFF);color:var(--color-base,#202122)}.mw-parser-output .sisicon,.mw-parser-output .dabicon{padding-right:1ex}</style><ul class=\"plainSister\"><li class=\"sisitem\"><span class=\"sisicon\"><span typeof=\"mw:File/Frameless\"><a href=\"/wiki/Special:SiteMatrix\" title=\"Special:SiteMatrix\"><img alt=\"Sister Projects\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/8/81/Wikimedia-logo.svg/20px-Wikimedia-logo.svg.png?utm_source=en.wikisource.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"18\" height=\"18\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/8/81/Wikimedia-logo.svg/40px-Wikimedia-logo.svg.png?utm_source=en.wikisource.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1024\" data-file-height=\"1024\" /></a></span></span><a href=\"/wiki/Special:SiteMatrix\" title=\"Special:SiteMatrix\">sister projects</a>: <a href=\"https://www.wikidata.org/wiki/Q107367614\" class=\"extiw\" title=\"d:Q107367614\">Wikidata item</a></li></ul></div><div class=\"ws-noexport\" id=\"ws-data\" style=\"speak:none\"><span id=\"ws-article-id\">3649149</span><span id=\"ws-title\"><a href=\"/wiki/Eminent_Chinese_of_the_Ch%27ing_Period\" title=\"Eminent Chinese of the Ch&#39;ing Period\">Eminent Chinese of the Ch'ing Period</a>, Volume 1 \u2014 Nikan (d. 1652)</span><span id=\"ws-editor\">Arthur W. Hummel</span><span id=\"ws-author\">George A. Kennedy</span></div></div>\n<p><span style=\"display:none\" id=\"dynamic&#95;layout&#95;overrider\">Layout 2</span>\n</p>\n<div class=\"prp-pages-output\" lang=\"en\">\n<p><span><span class=\"pagenum ws-pagenum\" id=\"590\" data-page-number=\"590\" data-page-name=\"Page:Eminent Chinese Of The Ch\u2019ing Period - Hummel - 1943 - Vol. 1.pdf/602\" data-page-index=\"602\" data-page-quality=\"3\" title=\"Page:Eminent&#95;Chinese&#95;Of&#95;The&#95;Ch%E2%80%99ing&#95;Period&#95;-&#95;Hummel&#95;-&#95;1943&#95;-&#95;Vol.&#95;1.pdf/602\"><span id=\"pageindex&#95;602\" class=\"pagenum-inner ws-noexport\">&#8203;</span></span></span><b>NIKAN</b> \u5c3c\u582a, d. 1652, age 43 (<i>sui</i>), member of the Imperial Family, was the third son of <span class=\"ws-authlkpl\"><a href=\"/wiki/Eminent_Chinese_of_the_Ch%27ing_Period/Cuyen\" title=\"Eminent Chinese of the Ch&#39;ing Period/Cuyen\">Cuyen</a></span>&#32;[<i>q.&#8239;v.</i>] and a grandson of <span class=\"ws-authlkpl\"><a href=\"/wiki/Eminent_Chinese_of_the_Ch%27ing_Period/Nurhaci\" title=\"Eminent Chinese of the Ch&#39;ing Period/Nurhaci\">Nurhaci</a></span>&#32;[<i>q.&#8239;v.</i>]. After taking part in wars against the Dolot and other Mongol tribes, he was associated with <span class=\"ws-authlkpl\"><a href=\"/wiki/Eminent_Chinese_of_the_Ch%27ing_Period/Dodo\" title=\"Eminent Chinese of the Ch&#39;ing Period/Dodo\">Dodo</a></span>&#32;[<i>q.&#8239;v.</i>] in 1635 in the latter's attempt to engage the attention of the Chinese on the eastern front while other armies invaded Shansi from the north. In the next year he received the rank of <i>beise</i> and accompanied Dodo into Korea. From 1639 on he was in the expedition led by <span class=\"ws-authlkpl\"><a href=\"/wiki/Eminent_Chinese_of_the_Ch%27ing_Period/Ajige\" title=\"Eminent Chinese of the Ch&#39;ing Period/Ajige\">Ajige</a></span> and <span class=\"ws-authlkpl\"><a href=\"/wiki/Eminent_Chinese_of_the_Ch%27ing_Period/Dorgon\" title=\"Eminent Chinese of the Ch&#39;ing Period/Dorgon\">Dorgon</a></span>&#32;[<i>qq.&#8239;v.</i>] which carried the war on towards Shanhaikuan, and when this pass was forced in 1644 he received promotion to <i>beile</i>. Until 1648 he served chiefly in the west of China with Dodo and <span class=\"ws-authlkpl\"><a href=\"/wiki/Eminent_Chinese_of_the_Ch%27ing_Period/Haoge\" title=\"Eminent Chinese of the Ch&#39;ing Period/Haoge\">Haoge</a></span>&#32;[<i>q.&#8239;v.</i>]. Like <span class=\"ws-authlkpl\"><a href=\"/wiki/Eminent_Chinese_of_the_Ch%27ing_Period/Bolo\" title=\"Eminent Chinese of the Ch&#39;ing Period/Bolo\">Bolo</a></span>&#32;[<i>q.&#8239;v.</i>], he was a supporter of Dorgon and in October 1648 was given a second degree princedom designated Ching-chin Ch\u00fcn-wang \u656c\u8b39\u90e1\u738b. Shortly afterwards, he was sent to Shansi at&#32;<span><span class=\"pagenum ws-pagenum\" id=\"591\" data-page-number=\"591\" data-page-name=\"Page:Eminent Chinese Of The Ch\u2019ing Period - Hummel - 1943 - Vol. 1.pdf/603\" data-page-index=\"603\" data-page-quality=\"3\" title=\"Page:Eminent&#95;Chinese&#95;Of&#95;The&#95;Ch%E2%80%99ing&#95;Period&#95;-&#95;Hummel&#95;-&#95;1943&#95;-&#95;Vol.&#95;1.pdf/603\"><span id=\"pageindex&#95;603\" class=\"pagenum-inner ws-noexport\">&#8203;</span></span></span>the head of the expedition against the rebel, <span class=\"ws-authlkpl\"><a href=\"/wiki/Eminent_Chinese_of_the_Ch%27ing_Period/Chiang_Hsiang\" title=\"Eminent Chinese of the Ch&#39;ing Period/Chiang Hsiang\">Chiang Hsiang</a></span>&#32;[<i>q.&#8239;v.</i>]. He was then promoted to Ch'in-wang \u89aa\u738b, or prince of the first degree, and in 1650 was associated with <span class=\"ws-authlkpl\"><a href=\"/wiki/Eminent_Chinese_of_the_Ch%27ing_Period/Mandahai\" title=\"Eminent Chinese of the Ch&#39;ing Period/Mandahai\">Mandahai</a></span>&#32;[<i>q.&#8239;v.</i>] and Bolo in directing the work of the Six Boards. Within nine months he was twice degraded in rank on minor charges and was twice reinstated. He turned against Dorgon after the latter died and so kept his position. For a time he was put in charge of the Board of Ceremonies, and in 1652 was made head of the Imperial Clan Court. On August 18, 1652 he was given the title of Ting-y\u00fcan Ta Chiang-ch\u00fcn \u5b9a\u9060\u5927\u5c07\u8ecd, and proceeded against the Ming loyalist, <span class=\"ws-authlkpl\"><a href=\"/wiki/Eminent_Chinese_of_the_Ch%27ing_Period/Li_Ting-kuo\" title=\"Eminent Chinese of the Ch&#39;ing Period/Li Ting-kuo\">Li Ting-kuo</a></span>&#32;[<i>q.&#8239;v.</i>], in Hunan. At Heng-chou, while pursuing Li's general, Ma Chin-chung \u99ac\u9032\u5fe0 (<style data-mw-deduplicate=\"TemplateStyles:r14767791\">.mw-parser-output .wst-tooltip{cursor:help;border-bottom:thin dotted cornflowerblue}.mw-parser-output .wst-tooltip-nodash{border-bottom:none}</style><span class=\"wst-tooltip wst-tooltip-dash\" title=\"Courtesy name (Tz\u00fb/Zi, \u5b57)\">T.</span>&#160;\u8475\u4e8e), he was surrounded by the enemy and died in battle. His body was brought to Peking and buried with honors, and the posthumous name, Chuang \u838a, was conferred upon him. Nikan's wife was a niece of <span class=\"ws-authlkpl\"><a href=\"/wiki/Eminent_Chinese_of_the_Ch%27ing_Period/Ebilun\" title=\"Eminent Chinese of the Ch&#39;ing Period/Ebilun\">Ebilun</a></span>&#32;[<i>q.&#8239;v.</i>].\n</p><p>In 1659 Nikan was posthumously accused, among other things, of having appropriated for his own use part of Dorgon's confiscated property. But because he had died in battle for the dynasty, his hereditary rank was allowed to continue. In 1669 his son, Lambu \u862d\u5e03 (d. 1678), was reduced to a prince of the fifth degree for concealing the misdemeanors of his wife's grandfather, <span class=\"ws-authlkpl\"><a href=\"/wiki/Eminent_Chinese_of_the_Ch%27ing_Period/Oboi\" title=\"Eminent Chinese of the Ch&#39;ing Period/Oboi\">Oboi</a></span>&#32;[<i>q.&#8239;v.</i>]. Lambu's descendants inherited the lower rank of a sixth degree princedom, but in 1778 Emperor Kao-tsung, in honor of Nikan, raised that rank one degree and gave it the rights of perpetual inheritance.\n</p>\n<style data-mw-deduplicate=\"TemplateStyles:r15431518\">.mw-parser-output .wst-rule{background-color:currentcolor;color:inherit;width:auto;margin:2px auto 2px auto;height:1px;overflow:hidden}.mw-parser-output .wst-rule.wst-rule-left{margin-left:0}.mw-parser-output .wst-rule.wst-rule-right{margin-right:0}.mw-parser-output .wst-rule.__uirule{background-color:#a2a9b1;color:inherit;border:0;margin-top:0.2em;margin-bottom:0.2em}</style><hr class=\"wst-rule wst-rule-left\" style=\"color:inherit;width:40%;\" />\n<p>[1/222/3b; 2/2/34b; 3/ <i>shou</i> 7/1a; 34/128/5a.]\n</p>\n<style data-mw-deduplicate=\"TemplateStyles:r15431519\">.mw-parser-output .wst-right{text-align:right}</style><div class=\"wst-right\" style=\"margin-right:2em;\">\n<p><span class=\"smallcaps\" style=\"font-variant:small-caps;\">George A. Kennedy</span>\n</p>\n</div>\n<p><br />\n&#32;\n</p>\n</div>\n<p><span class=\"error\"></span>\n</p></div>"},"links":[{"ns":0,"exists":"","*":"Eminent Chinese of the Ch'ing Period"},{"ns":0,"exists":"","*":"Eminent Chinese of the Ch'ing Period/Ajige"},{"ns":0,"exists":"","*":"Eminent Chinese of the Ch'ing Period/Bolo"},{"ns":0,"exists":"","*":"Eminent Chinese of the Ch'ing Period/Chiang Hsiang"},{"ns":0,"exists":"","*":"Eminent Chinese of the Ch'ing Period/Cuyen"},{"ns":0,"exists":"","*":"Eminent Chinese of the Ch'ing Period/Dodo"},{"ns":0,"exists":"","*":"Eminent Chinese of the Ch'ing Period/Dorgon"},{"ns":0,"exists":"","*":"Eminent Chinese of the Ch'ing Period/Ebilun"},{"ns":0,"exists":"","*":"Eminent Chinese of the Ch'ing Period/Haoge"},{"ns":0,"exists":"","*":"Eminent Chinese of the Ch'ing Period/Li Ting-kuo"},{"ns":0,"exists":"","*":"Eminent Chinese of the Ch'ing Period/Mandahai"},{"ns":0,"exists":"","*":"Eminent Chinese of the Ch'ing Period/Nien K\u00eang-yao"},{"ns":0,"exists":"","*":"Eminent Chinese of the Ch'ing Period/Nikan (d. 1660)"},{"ns":0,"exists":"","*":"Eminent Chinese of the Ch'ing Period/Nurhaci"},{"ns":0,"exists":"","*":"Eminent Chinese of the Ch'ing Period/Oboi"},{"ns":102,"exists":"","*":"Author:Arthur W. Hummel"},{"ns":102,"exists":"","*":"Author:George A. Kennedy"}],"sections":[],"wikitext":{"*":"{{Eminent Chinese of the Ch'ing Period\n | volume   = 1\n | onlysection = nikan (d. 1652)\n | previous = Nien K\u00eang-yao\n | next     = Nikan (d. 1660)\n | from     = 602\n | to       = 603\n | notes    =\n | section_author = George A. Kennedy\n}}{{DEFAULTSORT:Nikan (d. 1652)}}"}}}