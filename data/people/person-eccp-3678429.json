    "registration": {
      "attestations": [
        {
          "text": "YÜ Ch'êng-lung 于成龍 (T. 北溟, H. 于山), Sept. 26, 1617–1684, May 31, official, was a native of Yung-ning, Shansi. A senior licentiate (kung-shêng) of 1639, he began his offcial career in 1661 at forty-five sui, as magistrate of Lo-ch'êng, Kwangsi.",
          "source": "eccp-3678429",
          "kind": "source-wording",
          "status": "imported"
        },
        {
          "text": "YÜ Ch'êng-lung 于成龍 (T. 振甲 H. 如山), Aug. 14, 1638–1700, Apr. 16, official, was a native of Kai-p'ing, Liaotung. His family, which belonged to the Chinese Bordered Red Banner, migrated to Chihli in 1648 and, after several removals, settled in the Ku-an district of that province in 1653.",
          "source": "eccp-3678430",
          "kind": "source-wording",
          "status": "imported"
        },
        {
          "text": "于成龍，字北溟，山西永寧人。",
          "source": "qsg-volume-277",
          "kind": "biographical-opening",
          "status": "proposed"
        }
      ]
