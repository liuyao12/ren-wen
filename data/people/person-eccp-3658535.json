    "registration": {
      "attestations": [
        {
          "text": "TU Li-tê 杜立德 (T. 純一, H. 敬修), 1611–1691, July 3, official, was a native of Pao-ti, Chihli. He became a chin-shih at the last Ming examinations in 1643. Two years later, through the recommendation of Sung Ch'üan [q. v.], he was appointed a censor in the new regime.",
          "source": "eccp-3658535",
          "kind": "source-wording",
          "status": "imported"
        },
