    "registration": {
      "attestations": [
        {
          "text": "T'IEN Hsiung 田雄, d. 1663, Ming-Ch'ing general and admiral, was a native of Hsüan-hua, Chihli. A brigade-general under the Ming regime, he was associated in 1645 with Ma Tê-kung [q. v.] in betraying the Prince of Fu (see Chu Yu-sung) to the Manchus.",
          "source": "eccp-3656373",
          "kind": "source-wording",
          "status": "imported"
        },
        {
          "text": "田雄，直隸宣化人。",
          "source": "qsg-volume-248",
          "kind": "biographical-opening",
          "status": "proposed"
        }
      ]
    },
