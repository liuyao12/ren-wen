    "registration": {
      "attestations": [
        {
          "text": "HO Ch'ang-ling 賀長齡 (T. 耦庚, H. 西涯, 耐庵, 齧缺叟), Mar. 18, 1785–1848, July 6, official, was a native of Shan-hua, Hunan. Several of his immediate ancestors were petty judicial officials. He studied for about a year in the Yüeh-lu (嶽麓) Academy at Shan-hua, becoming a chü-jên in 1807, and a chin-shih in 1808.",
          "source": "eccp-3639245",
          "kind": "source-wording",
          "status": "imported"
        },
        {
          "text": "賀長齡，字耦耕，湖南善化人，原籍浙江會稽。",
          "source": "qsg-volume-380",
          "kind": "biographical-opening",
          "status": "proposed"
        }
