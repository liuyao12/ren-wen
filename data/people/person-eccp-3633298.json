    "registration": {
      "attestations": [
        {
          "text": "CHANG T'ing-shu 張廷樞 (T. 景峰) d. 1729, official, was a native of Han-ch'êng, Shensi. His father, Chang Ku-hsing (張顧行, a chin-shih of 1667), was grain intendant of Nanking. Chang T'ing-shu became a chin-shih in 1682 and after a period of study in the Hanlin Academy received the rank of a compiler.",
          "source": "eccp-3633298",
          "kind": "source-wording",
          "status": "imported"
        },
        {
          "text": "張廷樞，字景峰，陝西韓城人。",
          "source": "qsg-volume-264",
          "kind": "biographical-opening",
          "status": "proposed"
        }
