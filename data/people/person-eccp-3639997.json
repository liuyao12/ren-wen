    "registration": {
      "attestations": [
        {
          "text": "HUANG Chi 黃機 (T. 次辰, H. 雪臺), d. 1686 age 75 (sui), official and scholar, was a native of Ch'ien-t'ang (Hangchow). He became a chin-shih in 1647 and after a period of study in the Hanlin Academy was in 1649 made a compiler of the second class in the Hung-wên yüan 宏文院.",
          "source": "eccp-3639997",
          "kind": "source-wording",
          "status": "imported"
        },
        {
          "text": "黃機，字次辰，浙江錢塘人。",
          "source": "qsg-volume-250",
          "kind": "biographical-opening",
          "status": "proposed"
